{
  "name": "@keysqiu/ssh-mcp-server",
  "version": "1.1.0",
  "description": "SSH-based MCP Server (基于 SSH 的 MCP 服务器)",
  "main": "build/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SIE-Operations-and-Maintenance-Team/ssh-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/SIE-Operations-and-Maintenance-Team/ssh-mcp-server/issues"
  },
  "homepage": "https://github.com/SIE-Operations-and-Maintenance-Team/ssh-mcp-server#readme",
  "bin": {
    "ssh-mcp-server": "build/index.js"
  },
  "scripts": {
    "test": "node scripts/run-tests.js",
    "test:watch": "node --test --watch test/**/*.test.js",
    "build": "node scripts/build.js",
    "build:watch": "tsc --watch",
    "build:tauri": "npx tauri build",
    "build:admin": "npm --prefix admin-web run build",
    "dev": "D:\\develop\\environment\\nodejs\\node.exe node_modules/@tauri-apps/cli/tauri.js dev",
    "dev:watch": "concurrently --shell bash \"npm:build:watch\" \"npm:dev:frontend\"",
    "dev:backend": "npm run build:watch",
    "dev:frontend": "npm --prefix admin-web run dev",
    "dev:admin": "node build/index.js --admin --admin-port 61823",
    "dev:admin:watch": "concurrently --shell bash \"npm:build:watch\" \"npx nodemon --watch build --delay 500 build/index.js --admin --admin-port 61823\"",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "prepublishOnly": "npm run build",
    "prepack": "node scripts/prepack.js || \"D:/develop/environment/nodejs/node.exe\" scripts/prepack.js",
    "version:bump": "node scripts/bump-version.mjs",
    "tauri:build": "tauri build",
    "dev:tauri:pre": "npm run build && concurrently --kill-others \"npm:build:watch\" \"npm:dev:frontend\" \"npx nodemon --watch build --delay 500 build/index.js --admin --admin-port 61823\""
  },
  "keywords": [
    "ssh",
    "mcp",
    "server",
    "cli"
  ],
  "author": "SIE Operations and Maintenance Team",
  "license": "ISC",
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "fastify": "^5.12.1",
    "socks": "^2.8.7",
    "ssh2": "^1.17.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.13.10",
    "@types/ssh2": "^1.15.5",
    "c8": "^12.0.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "typescript": "^5.8.2"
  },
  "files": [
    "build/**/*",
    "admin-web/dist/**/*",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ]
}
